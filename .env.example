# Dominio canónico del sitio (sin barra final)
SITE_URL=https://www.mavenfilms.com.co

# Servidor Node (producción)
HOST=0.0.0.0
PORT=4321
# true si el sitio corre detrás de un proxy/CDN que envía X-Forwarded-For
# (Hostinger, Cloudflare, Nginx). Se usa para el límite de envíos del formulario.
TRUST_PROXY=false

# Envío de cotizaciones por correo (opcional). Si no se configura, las solicitudes
# se registran en los logs del servidor y el usuario puede continuar por WhatsApp.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
QUOTE_TO=ventas@mavenfilms.com.co
QUOTE_FROM="Maven Films Web <no-reply@mavenfilms.com.co>"
