---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import GlassMotif from '@/components/ui/GlassMotif.astro';

interface Props {
  eyebrow?: string;
  /** Admite HTML simple para resaltar palabras. */
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  breadcrumbs?: { name: string; href: string }[];
  size?: 'lg' | 'md' | 'sm';
}
const { eyebrow, title, lead, image, imageAlt = '', breadcrumbs, size = 'md' } = Astro.props;
---

<section
  class:list={[
    'relative isolate overflow-hidden bg-petroleo-950 text-white',
    size === 'lg' && 'pt-36 pb-24 lg:pt-44 lg:pb-32',
    size === 'md' && 'pt-32 pb-20 lg:pt-40 lg:pb-24',
    size === 'sm' && 'pt-32 pb-14 lg:pt-36 lg:pb-16',
  ]}
>
  {
    image && (
      <Picture
        src={image}
        alt={imageAlt}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1600, 2000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 -z-20 h-full w-full object-cover"
      />
    )
  }
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-petroleo-950 via-petroleo-950/85 to-petroleo-950/30"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-petroleo-950/90 via-transparent to-petroleo-950/50"></div>
  <div class="absolute inset-0 -z-10 bg-grain opacity-[0.05]"></div>
  {!image && <GlassMotif class="absolute top-24 -right-16 hidden size-[26rem] opacity-80 lg:block" />}

  <div class="container-page">
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} class="mb-8" />}
    <div class="max-w-3xl">
      {eyebrow && <p class="eyebrow eyebrow-light">{eyebrow}</p>}
      <h1
        class:list={['mt-5 leading-[1.05] font-semibold !text-white', size === 'sm' ? 'text-4xl sm:text-5xl' : 'text-[2.5rem] sm:text-6xl lg:text-[4.25rem]']}
        set:html={title}
      />
      {lead && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/75 sm:text-xl">{lead}</p>}
      <slot />
    </div>
  </div>
</section>
