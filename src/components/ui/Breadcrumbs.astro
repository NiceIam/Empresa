---
/**
 * Migas de pan. En móvil se comprimen a «← Nivel anterior» (el título de la página ya dice dónde estás).
 */
import Icon from '@/components/ui/Icon.astro';
interface Props { items: { name: string; href: string }[]; class?: string }
const { items, class: className = '' } = Astro.props;
const parentIndex = items.length - 2;
---

<nav aria-label="Ruta de navegación" class={className}>
  <ol class="flex flex-wrap items-center gap-1.5 text-sm text-white/60">
    {
      items.map((item, i) => (
        <li class:list={['items-center gap-1.5', i === parentIndex ? 'flex' : 'hidden sm:flex']}>
          {i > 0 && <Icon name="chevron-right" class="hidden size-3.5 text-white/35 sm:block" />}
          {i === parentIndex && <Icon name="chevron-left" class="size-4 text-white/50 sm:hidden" />}
          {i < items.length - 1 ? (
            <a href={item.href} class="transition hover:text-white">{item.name}</a>
          ) : (
            <span aria-current="page" class="text-white/90">{item.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
