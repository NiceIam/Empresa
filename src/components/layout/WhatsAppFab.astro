---
import Icon from '@/components/ui/Icon.astro';
import { whatsappUrl } from '@/config/site';

interface Props { message?: string }
const { message } = Astro.props;
---

<a
  href={whatsappUrl(message)}
  target="_blank"
  rel="noopener"
  class="group fixed right-4 bottom-4 z-40 flex items-center gap-3 rounded-full bg-[#25D366] p-3.5 text-white shadow-[0_12px_32px_-8px_rgb(37_211_102_/_0.6)] transition-all duration-500 ease-out-expo hover:pr-5 sm:right-6 sm:bottom-6"
  aria-label="Escríbenos por WhatsApp"
  data-wa-fab
>
  <span class="absolute inset-0 -z-10 animate-ping rounded-full bg-[#25D366]/40 [animation-duration:2.5s] motion-reduce:hidden"></span>
  <Icon name="whatsapp" class="size-7" />
  <span class="hidden max-w-0 overflow-hidden font-display text-sm font-semibold whitespace-nowrap transition-all duration-500 ease-out-expo group-hover:max-w-40 sm:block">
    Cotiza por WhatsApp
  </span>
</a>
