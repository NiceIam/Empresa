---
/**
 * Simulador antes/después con dos modos:
 * - Control solar: tonos de 70 % a 5 % (tinte ahumado).
 * - Privacidad: esmerilado, opalizado, venetian y franja (desenfoque + velo blanco + máscara).
 */
import { Picture } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import sala from '@/assets/images/sala-ventanales.jpg';

interface Props { mode?: 'solar' | 'privacy' }
const { mode = 'solar' } = Astro.props;

interface Opt {
  id: string;
  label: string;
  name: string;
  privacy: number;
  light: number;
  use: string;
  href: string;
  badge: string;
  alpha?: number;
  blur?: number;
  white?: number;
  mask?: string;
}

const solar: Opt[] = [
  { id: 's70', label: '70 %', name: 'MKR70', alpha: 0.2, privacy: 1, light: 5, use: 'Casi invisible. Rechaza calor conservando la vista y la fachada.', href: '/peliculas/control-solar/nanoceramica-mkr70/', badge: 'Control solar 70 %' },
  { id: 's50', label: '50 %', name: 'Sutil', alpha: 0.36, privacy: 2, light: 4, use: 'Toque ahumado elegante. Ideal para salas y oficinas luminosas.', href: '/peliculas/control-solar/polarizado-nanoceramico/', badge: 'Control solar 50 %' },
  { id: 's35', label: '35 %', name: 'Equilibrado', alpha: 0.52, privacy: 3, light: 3, use: 'El favorito en hogares: privacidad diurna y buena luz natural.', href: '/peliculas/control-solar/polarizado-nanoceramico/', badge: 'Control solar 35 %' },
  { id: 's20', label: '20 %', name: 'Privado', alpha: 0.68, privacy: 4, light: 2, use: 'Alta privacidad y control de brillo para habitaciones y estudios.', href: '/peliculas/control-solar/polarizado-convencional/', badge: 'Control solar 20 %' },
  { id: 's5', label: '5 %', name: 'Máximo', alpha: 0.86, privacy: 5, light: 1, use: 'Privacidad máxima. Para zonas con sol intenso o que exigen reserva total.', href: '/peliculas/control-solar/polarizado-convencional/', badge: 'Control solar 5 %' },
];
const privacy: Opt[] = [
  { id: 'p-franja', label: 'Franja', name: 'Esmerilada', blur: 9, white: 0.28, mask: 'linear-gradient(180deg, transparent 34%, #000 34%, #000 60%, transparent 60%)', privacy: 2, light: 5, use: 'Una banda a la altura de los ojos: privacidad justa y señaliza el vidrio para que nadie choque.', href: '/peliculas/decorativas/frosted-esmerilado/', badge: 'Franja esmerilada' },
  { id: 'p-frost', label: 'Esmerilado', name: 'Sandblasting', blur: 8, white: 0.26, mask: 'none', privacy: 4, light: 4, use: 'El acabado del vidrio arenado: deja pasar la luz y difumina la vista.', href: '/peliculas/decorativas/frosted-esmerilado/', badge: 'Esmerilado' },
  { id: 'p-venetian', label: 'Venetian', name: 'Persiana', blur: 9, white: 0.32, mask: 'repeating-linear-gradient(180deg, #000 0 26px, transparent 26px 36px)', privacy: 3, light: 4, use: 'Franjas tipo persiana con control solar incluido. Orden visual sin cortinas.', href: '/peliculas/decorativas/venetian-persiana/', badge: 'Venetian' },
  { id: 'p-opal', label: 'Opalizado', name: 'Total', blur: 18, white: 0.64, mask: 'none', privacy: 5, light: 3, use: 'Privacidad total con luz difusa. Ideal para baños, consultorios y vestidores.', href: '/peliculas/decorativas/blanca-mate-opalizada/', badge: 'Opalizado' },
];
const groups = [
  { mode: 'solar', label: 'Control solar', icon: 'sun', opts: solar, initial: solar[2], aria: 'Tono de la película (transmisión de luz visible)' },
  { mode: 'privacy', label: 'Privacidad', icon: 'eye-off', opts: privacy, initial: privacy[1], aria: 'Acabado de privacidad' },
] as const;
const initial = solar[2];
const optData = (o: Opt) => ({
  'data-alpha': o.alpha ?? 0,
  'data-blur': o.blur ?? 0,
  'data-white': o.white ?? 0,
  'data-mask': o.mask ?? 'none',
  'data-privacy': o.privacy,
  'data-light': o.light,
  'data-use': o.use,
  'data-href': o.href,
  'data-badge': o.badge,
});
---

<section class="relative overflow-hidden bg-petroleo-950 py-24 text-white lg:py-32" id="simulador" data-initial-mode={mode}>
  <div class="absolute inset-0 bg-grain opacity-[0.04]"></div>
  <div class="container-page relative grid items-center gap-14 lg:grid-cols-[1fr_1.35fr]">
    <div>
      <SectionHeading
        eyebrow="Simulador"
        title={'Mira cómo se vería <span class="text-ambar-300">tu ventana</span>'}
        lead="Arrastra el control para comparar sin película y con película. Prueba tonos de control solar o acabados de privacidad."
        tone="dark"
      />

      <!-- Modo -->
      <div class="mt-10 inline-flex rounded-full bg-white/8 p-1 ring-1 ring-white/10" role="group" aria-label="Tipo de película">
        {
          groups.map((g, i) => (
            <button
              type="button"
              class="mode-btn flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold text-white/70 transition hover:text-white aria-pressed:bg-white aria-pressed:text-petroleo-900"
              aria-pressed={i === 0 ? 'true' : 'false'}
              data-mode={g.mode}
            >
              <Icon name={g.icon} class="size-4" />
              {g.label}
            </button>
          ))
        }
      </div>

      {
        groups.map((g, gi) => (
          <div class="opt-group mt-5" role="radiogroup" aria-label={g.aria} data-group={g.mode} hidden={gi !== 0}>
            <div class:list={['grid gap-2', g.opts.length === 5 ? 'grid-cols-5' : 'grid-cols-2 sm:grid-cols-4']}>
              {g.opts.map((o) => (
                <button
                  type="button"
                  role="radio"
                  aria-checked={o.id === g.initial.id ? 'true' : 'false'}
                  tabindex={o.id === g.initial.id ? 0 : -1}
                  class="opt-btn group rounded-2xl border border-white/12 px-2 py-3 text-center transition hover:border-white/40 aria-checked:border-ambar-400 aria-checked:bg-ambar-400 aria-checked:text-petroleo-950"
                  {...optData(o)}
                >
                  <span class="block font-display text-[1.05rem] leading-tight font-semibold">{o.label}</span>
                  <span class="mt-0.5 block text-[0.7rem] text-white/60 group-aria-checked:text-petroleo-900/80">{o.name}</span>
                </button>
              ))}
            </div>
          </div>
        ))
      }

      <div class="mt-8 grid gap-4 rounded-3xl glass p-6">
        <dl class="grid gap-4">
          <div class="flex items-center justify-between gap-4">
            <dt class="text-sm text-white/70">Luz natural</dt>
            <dd class="flex gap-1" data-meter="light" aria-label={`${initial.light} de 5`}>
              {Array.from({ length: 5 }, (_, i) => <span class:list={['h-2 w-7 rounded-full transition-colors duration-500', i < initial.light ? 'bg-ambar-400' : 'bg-white/15']} />)}
            </dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="text-sm text-white/70">Privacidad diurna</dt>
            <dd class="flex gap-1" data-meter="privacy" aria-label={`${initial.privacy} de 5`}>
              {Array.from({ length: 5 }, (_, i) => <span class:list={['h-2 w-7 rounded-full transition-colors duration-500', i < initial.privacy ? 'bg-ambar-400' : 'bg-white/15']} />)}
            </dd>
          </div>
        </dl>
        <div class="border-t border-white/10 pt-4">
          <p class="text-[0.95rem] leading-relaxed text-white/85" data-sim-use aria-live="polite">{initial.use}</p>
          <a href={initial.href} data-sim-link class="mt-3 inline-flex items-center gap-1.5 font-display text-sm font-semibold text-ambar-300 hover:text-ambar-200">
            Ver película recomendada <Icon name="arrow-right" class="size-4" />
          </a>
        </div>
      </div>
      <p class="mt-4 flex items-start gap-2 text-xs text-white/45">
        <Icon name="info" class="mt-0.5 size-3.5 shrink-0" /> Simulación ilustrativa. Te llevamos muestras reales para comparar sobre tu propio vidrio.
      </p>
    </div>

    <div class="relative" data-reveal>
      <div
        class="compare relative aspect-[4/5] overflow-hidden rounded-[2rem] shadow-2xl ring-1 ring-white/10 select-none sm:aspect-[5/4]"
        style={`--pos:50%; --alpha:${initial.alpha}; --blur:0px; --white:0; --mask:none`}
        data-mode="solar"
      >
        <Picture
          src={sala}
          alt="Sala con ventanal amplio usada para simular la película sobre el vidrio"
          formats={['avif', 'webp']}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1024px) 700px, 100vw"
          class="absolute inset-0 h-full w-full object-cover"
          loading="lazy"
        />
        <!-- Capa de privacidad: la misma foto desenfocada (el navegador reutiliza la descarga) -->
        <div class="frost absolute inset-0 overflow-hidden" aria-hidden="true">
          <Picture
            src={sala}
            alt=""
            formats={['avif', 'webp']}
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 1024px) 700px, 100vw"
            class="frost-img absolute inset-0 h-full w-full object-cover"
            loading="lazy"
          />
          <div class="frost-veil absolute inset-0"></div>
        </div>
        <div class="tint absolute inset-0" aria-hidden="true"></div>
        <div class="handle pointer-events-none absolute inset-y-0 w-0.5 bg-white/90 shadow-[0_0_20px_rgba(0,0,0,0.4)]" aria-hidden="true">
          <span class="absolute top-1/2 left-1/2 grid size-12 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white text-petroleo-900 shadow-xl">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18-6-6 6-6M15 6l6 6-6 6" /></svg>
          </span>
        </div>
        <span class="absolute top-4 left-4 rounded-full bg-petroleo-950/60 px-3 py-1 text-xs font-semibold text-white backdrop-blur-md">Sin película</span>
        <span class="absolute top-4 right-4 rounded-full bg-ambar-400 px-3 py-1 text-xs font-semibold text-petroleo-950" data-sim-badge>{initial.badge}</span>
        <label class="sr-only" for="compare-range">Desliza para comparar sin película y con película</label>
        <input id="compare-range" type="range" min="0" max="100" value="50" class="compare-range absolute inset-0 h-full w-full cursor-ew-resize opacity-0" />
      </div>
    </div>
  </div>
</section>

<style>
  .compare .tint {
    clip-path: inset(0 0 0 var(--pos));
    /* Tinte ahumado frío, similar a una película real sobre el vidrio. */
    background: linear-gradient(180deg, rgb(8 22 28 / calc(var(--alpha) * 0.92)), rgb(12 30 38 / var(--alpha)));
    transition: opacity 0.4s var(--ease-out-expo);
  }
  .compare .frost {
    clip-path: inset(0 0 0 var(--pos));
    mask-image: var(--mask);
    -webkit-mask-image: var(--mask);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out-expo);
  }
  .compare .frost-img {
    filter: blur(var(--blur)) saturate(0.85);
    transform: scale(1.08); /* evita bordes transparentes del desenfoque */
    transition: filter 0.5s var(--ease-out-expo);
  }
  .compare .frost-veil {
    background: rgb(247 247 245 / var(--white));
    transition: background 0.5s var(--ease-out-expo);
  }
  .compare[data-mode='privacy'] .frost { opacity: 1; }
  .compare[data-mode='privacy'] .tint { opacity: 0; }
  .compare .handle { left: var(--pos); }
  .compare:has(.compare-range:focus-visible) { outline: 2px solid var(--color-ambar-400); outline-offset: 4px; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('#simulador').forEach((root) => {
    const compare = root.querySelector<HTMLElement>('.compare')!;
    const range = root.querySelector<HTMLInputElement>('.compare-range')!;
    const useEl = root.querySelector<HTMLElement>('[data-sim-use]')!;
    const linkEl = root.querySelector<HTMLAnchorElement>('[data-sim-link]')!;
    const badge = root.querySelector<HTMLElement>('[data-sim-badge]')!;

    range.addEventListener('input', () => compare.style.setProperty('--pos', `${range.value}%`));

    const paint = (meter: string, value: number) => {
      const dd = root.querySelector<HTMLElement>(`[data-meter="${meter}"]`)!;
      dd.setAttribute('aria-label', `${value} de 5`);
      dd.querySelectorAll('span').forEach((s, i) => {
        s.classList.toggle('bg-ambar-400', i < value);
        s.classList.toggle('bg-white/15', i >= value);
      });
    };

    const select = (btn: HTMLButtonElement) => {
      const group = btn.closest<HTMLElement>('[data-group]')!;
      // Tabindex itinerante: solo la opción activa es parada de Tab (patrón radiogroup).
      group.querySelectorAll<HTMLButtonElement>('.opt-btn').forEach((b) => {
        b.setAttribute('aria-checked', String(b === btn));
        b.tabIndex = b === btn ? 0 : -1;
      });
      const d = btn.dataset;
      compare.dataset.mode = group.dataset.group;
      compare.style.setProperty('--alpha', d.alpha!);
      compare.style.setProperty('--blur', `${d.blur}px`);
      compare.style.setProperty('--white', d.white!);
      compare.style.setProperty('--mask', d.mask!);
      paint('light', Number(d.light));
      paint('privacy', Number(d.privacy));
      useEl.textContent = d.use!;
      linkEl.href = d.href!;
      badge.textContent = d.badge!;
    };

    root.querySelectorAll<HTMLElement>('[data-group]').forEach((group) => {
      const buttons = [...group.querySelectorAll<HTMLButtonElement>('.opt-btn')];
      buttons.forEach((btn, i) => {
        btn.addEventListener('click', () => select(btn));
        btn.addEventListener('keydown', (e) => {
          const dir = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
          if (!dir) return;
          e.preventDefault();
          const next = buttons[(i + dir + buttons.length) % buttons.length];
          next.focus();
          select(next);
        });
      });
    });

    // Cambio de modo: muestra su grupo y aplica la opción marcada en él.
    const modeButtons = root.querySelectorAll<HTMLButtonElement>('.mode-btn');
    modeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        root.querySelectorAll('.mode-btn').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        root.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => (g.hidden = g.dataset.group !== btn.dataset.mode));
        const group = root.querySelector<HTMLElement>(`[data-group="${btn.dataset.mode}"]`)!;
        select(group.querySelector<HTMLButtonElement>('.opt-btn[aria-checked="true"]')!);
      });
    });
    if (root.dataset.initialMode === 'privacy') root.querySelector<HTMLButtonElement>('.mode-btn[data-mode="privacy"]')?.click();
  });
</script>
