---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import QuoteWizard from '@/components/quote/QuoteWizard.astro';
import FaqList from '@/components/ui/FaqList.astro';
import { site, whatsappUrl } from '@/config/site';
import { generalFaqs } from '@/data/solutions';

// Se renderiza en el servidor para mostrar errores del envío sin JavaScript (?error=...).
export const prerender = false;
const errorMessages: Record<string, string> = {
  datos: 'Revisa tu nombre, tu celular y la autorización de datos.',
  limite: 'Recibimos varias solicitudes seguidas desde tu conexión. Espera unos minutos.',
  servidor: 'No pudimos enviar tu solicitud en este momento.',
};
const serverError = errorMessages[Astro.url.searchParams.get('error') ?? ''] ?? '';

const breadcrumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Contacto', href: '/contacto/' },
];
const faqs = generalFaqs.filter((f) => /cotizo|visita|garantía/i.test(f.q));
---

<BaseLayout
  title="Cotiza películas para vidrio en Bogotá"
  description="Cotiza películas para vidrio en Bogotá por WhatsApp, teléfono o correo. Respuesta en menos de un día hábil y visita técnica con muestras reales."
  breadcrumbs={breadcrumbs}
  schema={[{ '@type': 'ContactPage', name: 'Contacto Maven Films', url: Astro.url.href }]}
>
  <section class="relative isolate overflow-hidden bg-petroleo-950 pt-32 pb-40 text-white lg:pt-40 lg:pb-48">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_70%_60%_at_20%_0%,rgb(47_99_118_/_0.45),transparent_70%)]"></div>
    <div class="absolute inset-0 -z-10 bg-grain opacity-[0.05]"></div>
    <div class="container-page">
      <Breadcrumbs items={breadcrumbs} class="mb-8" />
      <div class="max-w-3xl">
        <p class="eyebrow eyebrow-light">Cotización sin costo</p>
        <h1 class="mt-5 text-[2.5rem] leading-[1.05] font-semibold !text-white sm:text-6xl">Hablemos de <span class="text-ambar-300">tus vidrios</span></h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/75">Cuéntanos qué necesitas. Te respondemos en menos de un día hábil con una recomendación y agendamos tu visita técnica con muestras reales.</p>
      </div>
    </div>
  </section>

  <section class="relative -mt-28 pb-24 lg:-mt-32">
    <div class="container-page grid gap-8 lg:grid-cols-[1.35fr_0.65fr]">
      <div>
        {
          serverError && (
            <p class="mb-4 rounded-2xl bg-red-50 px-5 py-4 text-sm text-red-800 shadow" role="alert">
              {serverError} Si prefieres, escríbenos por WhatsApp.
            </p>
          )
        }
        <div id="cotizar" class="scroll-mt-28">
          <QuoteWizard mode="inline" uid="qc" />
        </div>
      </div>

      <aside class="space-y-4">
        <a href={whatsappUrl()} target="_blank" rel="noopener" data-wa-source="contacto_lateral" class="group flex items-center gap-4 rounded-3xl bg-[#25D366] p-6 text-white shadow-[0_20px_40px_-20px_rgb(37_211_102_/_0.7)] transition hover:-translate-y-0.5">
          <span class="grid size-12 place-items-center rounded-2xl bg-white/20"><Icon name="whatsapp" class="size-6" /></span>
          <span class="flex-1">
            <span class="block font-display text-lg font-semibold">WhatsApp</span>
            <span class="text-sm text-white/90">La forma más rápida. Envíanos fotos.</span>
          </span>
          <Icon name="arrow-up-right" class="size-5 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
        </a>
        <div class="card divide-y divide-petroleo-900/8">
          <a href={`tel:${site.contact.phone}`} class="flex items-center gap-4 p-6 transition hover:bg-concreto/40">
            <span class="grid size-11 place-items-center rounded-xl bg-concreto text-petroleo-900"><Icon name="phone" class="size-5" /></span>
            <span><span class="block text-sm text-grafito/60">Teléfono</span><span class="font-display font-semibold text-petroleo-900">{site.contact.phoneDisplay}</span></span>
          </a>
          <a href={`mailto:${site.contact.email}`} class="flex items-center gap-4 p-6 transition hover:bg-concreto/40">
            <span class="grid size-11 place-items-center rounded-xl bg-concreto text-petroleo-900"><Icon name="mail" class="size-5" /></span>
            <span class="min-w-0"><span class="block text-sm text-grafito/60">Correo</span><span class="block truncate font-display font-semibold text-petroleo-900">{site.contact.email}</span></span>
          </a>
          <div class="flex items-center gap-4 p-6">
            <span class="grid size-11 place-items-center rounded-xl bg-concreto text-petroleo-900"><Icon name="map-pin" class="size-5" /></span>
            <span><span class="block text-sm text-grafito/60">Cobertura</span><span class="font-display font-semibold text-petroleo-900">{site.address.street ? `${site.address.street}, ` : ''}{site.address.locality} y la Sabana</span></span>
          </div>
          <div class="flex items-start gap-4 p-6">
            <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-concreto text-petroleo-900"><Icon name="clock" class="size-5" /></span>
            <span><span class="block text-sm text-grafito/60">Horario</span>{site.hours.map((h) => <span class="block font-medium text-petroleo-900">{h.days}: {h.open} – {h.close}</span>)}</span>
          </div>
        </div>
        <div class="rounded-3xl border border-petroleo-900/10 p-6">
          <p class="font-display font-semibold text-petroleo-900">Para cotizar más rápido</p>
          <ul class="mt-3 space-y-2 text-sm text-grafito/75">
            <li class="flex gap-2"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-petroleo-500" />Fotos de los vidrios (de lejos y de cerca)</li>
            <li class="flex gap-2"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-petroleo-500" />Medidas aproximadas de ancho y alto</li>
            <li class="flex gap-2"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-petroleo-500" />Qué quieres resolver: calor, privacidad, seguridad o diseño</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="container-page max-w-4xl">
      <h2 class="text-3xl font-semibold">Antes de escribirnos</h2>
      <FaqList faqs={faqs} class="mt-8" />
    </div>
  </section>
</BaseLayout>

